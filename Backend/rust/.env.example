# Copy to .env. Keep credentials on the backend only.
APP_ENV=development
BIND_ADDR=127.0.0.1:8080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Neon > Connect > select the intended branch, database and role > copy URL.
DATABASE_URL=postgresql://YOUR_ROLE:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
EXPECTED_DATABASE_NAME=neondb
AUTH_TEST_ENABLED=true
AUTH_TEST_PHONE=+917349083847
AUTH_TEST_OTP=000000

# Firebase Phone Authentication (set only when Firebase is enabled).
# Copy the public Web API key from your Firebase project's Android config.
FIREBASE_WEB_API_KEY=

# HDFC account verification is disabled until the bank's exact sandbox request
# and response schemas are available. Keep these backend-only values in Render
# secret fields or a local .env; never put them in Flutter or Git.
HDFC_ENV=disabled
HDFC_BASE_URL=https://api-tryitout-uat.hdfcbank.com
HDFC_CLIENT_ID=
HDFC_CLIENT_SECRET=

# Render: do not set BIND_ADDR or PORT. Render supplies PORT automatically.
# Set APP_ENV=production, AUTH_TEST_ENABLED=false, and use an HTTPS frontend
# URL in FRONTEND_ORIGINS. Configure DATABASE_URL and FIREBASE_WEB_API_KEY in
# Render's secret fields.
