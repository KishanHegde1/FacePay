# Copy to .env. Keep credentials on the backend only.
APP_ENV=development
BIND_ADDR=127.0.0.1:8080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Neon > Connect > select the intended branch, database and role > copy URL.
DATABASE_URL=postgresql://YOUR_ROLE:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
EXPECTED_DATABASE_NAME=neondb
AUTH_TEST_ENABLED=true
AUTH_TEST_PHONE=+917349083847
AUTH_TEST_OTP=000000

# Render: do not set BIND_ADDR or PORT. Render supplies PORT automatically.
# Set APP_ENV=production, AUTH_TEST_ENABLED=false, and use an HTTPS frontend
# URL in FRONTEND_ORIGINS. Configure DATABASE_URL in Render's secret fields.
